<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="For manual base64/hex/URL encode-decode, use Data Toolkit instead. This tool is for figuring out an UNKNOWN encoding/cipher automatically."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/cipherInput"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="top"
        android:hint="Paste the ciphertext/encoded text here"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAutoDecode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto-Decode (hex / base64 / XOR brute-force)"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/autoDecodeResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bh_border"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSolveCaesar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solve Caesar Cipher (brute force + frequency analysis)"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/caesarResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bh_border"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSolveVigenere"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solve Vigenere Cipher (key-length + frequency analysis)"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/vigenereResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
