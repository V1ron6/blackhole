<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JSON input"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/jsonInput"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:gravity="top"
        android:hint="{ &quot;key&quot;: &quot;value&quot; }"
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnFormatJson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Validate &amp; Format"
        android:textAllCaps="false"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/jsonStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Formatted output"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/jsonOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Path query (e.g. data.items[0].name)"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/jsonPathInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="data.items[0].name"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_dim"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnRunPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Query"
            android:textAllCaps="false"
            android:backgroundTint="@color/bh_accent" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Query result"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/jsonPathOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
