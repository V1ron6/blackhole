<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Endpoint"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/graphqlEndpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://example.com/graphql"
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:inputType="textUri"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRunIntrospection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Introspection Query"
        android:textAllCaps="false"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/graphqlStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/graphqlOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
