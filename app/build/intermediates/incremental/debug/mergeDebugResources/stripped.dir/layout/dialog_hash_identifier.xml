<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rule-based guess from length, charset and prefix - not a lookup. Several types can share a length (e.g. MD5/NTLM are both 32 hex chars), so treat ties as 'could be either'."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/hashInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste a hash, e.g. 5f4dcc3b5aa765d61d8327deb882cf99"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="2"
        android:maxLines="4"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnIdentifyHash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Identify"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/hashResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
