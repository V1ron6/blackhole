<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saved snippets"
        android:textColor="@color/bh_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/bookmarkletList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add new"
        android:textColor="@color/bh_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/bookmarkletName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name"
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:singleLine="true"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/bookmarkletCode"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="top"
        android:hint="document.title = 'hi'"
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnAddBookmarklet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Snippet"
        android:textAllCaps="false"
        android:backgroundTint="@color/bh_accent" />

</LinearLayout>
</ScrollView>
