<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/dnsTargetHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Queries via Google's DNS-over-HTTPS (dns.google) rather than the device's configured resolver - results reflect Google's view, not necessarily what your device would resolve locally (e.g. with split-horizon DNS)."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/dnsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Looking up\u2026"
        android:textColor="@color/bh_text"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/dnsOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
