<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reads the file's magic bytes to guess its real type, regardless of what its extension claims - the classic CTF 'this .png is actually a zip' check."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChooseFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose File"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/fileInspectorSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file selected."
        android:textColor="@color/bh_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/fileInspectorDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
