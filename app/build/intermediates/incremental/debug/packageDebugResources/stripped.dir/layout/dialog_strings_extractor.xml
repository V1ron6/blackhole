<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pulls printable-ASCII runs out of any file, like the Unix \'strings\' command. Files over 20 MB are rejected to stay phone-friendly."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChooseFileStrings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose File"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/stringsMinLength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Min length"
            android:inputType="number"
            android:text="4" />

        <EditText
            android:id="@+id/stringsFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Filter regex (optional, e.g. flag\\{.*?\\})" />
    </LinearLayout>

    <Button
        android:id="@+id/btnExtractStrings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extract"
        android:backgroundTint="@color/bh_accent"
        android:enabled="false"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/stringsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file selected."
        android:textColor="@color/bh_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/stringsResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:background="@drawable/bg_card_section"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
