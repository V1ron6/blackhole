<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Token"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/jwtInput"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="top"
        android:hint="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnDecodeJwt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Decode"
        android:textAllCaps="false"
        android:backgroundTint="@color/bh_accent"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/jwtExpiryStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Header"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/jwtHeaderOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payload"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/jwtPayloadOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Signature (not verified - no key entry here)"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/jwtSignatureOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
