<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Only scan hosts you own or have explicit written authorization to test. This sends real HTTP requests to every path in the list."
        android:textColor="@color/bh_danger"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/bustHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://example.com (defaults to current page)"
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:inputType="textUri"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:id="@+id/bustWordlistGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/radioBuiltinList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Built-in list (~170 common paths)"
            android:textColor="@color/bh_text"
            android:buttonTint="@color/bh_accent"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioCustomList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom (paste below, one per line)"
            android:textColor="@color/bh_text"
            android:buttonTint="@color/bh_accent" />
    </RadioGroup>

    <EditText
        android:id="@+id/bustCustomWordlist"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="top"
        android:hint="admin\nbackup\n.git\n..."
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:inputType="textMultiLine"
        android:visibility="gone"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Extensions (optional, comma-separated)"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/bustExtensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="php, html, txt, bak"
        android:textColor="@color/bh_text"
        android:textColorHint="@color/bh_text_dim"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kept light on purpose: capped at 2000 total requests per run, 8 at a time, short timeouts, response bodies never read into memory - just the status code. This is a small fuzzer, not a full gobuster replacement."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <CheckBox
        android:id="@+id/bustAuthorizedCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I own this host or have explicit authorization to test it"
        android:textColor="@color/bh_text"
        android:textSize="13sp"
        android:buttonTint="@color/bh_danger"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStartBust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Scan"
        android:textAllCaps="false"
        android:backgroundTint="@color/bh_accent"
        android:enabled="false"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/bustStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hits (non-404 only)"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/bustResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
