<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bh_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Runs in the active tab's page context, same as any content script."
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:id="@+id/consoleScroll"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/bh_surface"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/consoleOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/bh_text"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/consoleInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="document.title"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_dim"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:singleLine="true"
            android:imeOptions="actionGo" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Run"
            android:textAllCaps="false"
            android:backgroundTint="@color/bh_accent" />
    </LinearLayout>

</LinearLayout>
