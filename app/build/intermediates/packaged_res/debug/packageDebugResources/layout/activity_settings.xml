<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bh_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bh_surface"
        android:elevation="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/btnBackToTabs"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Back"
            app:tint="@color/bh_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Settings"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Security Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_section"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Security Mode"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Strict blocks all http:// connections and never allows a TLS cert error through. CTF Mode allows http:// for lab/wargame targets - cert-error blocking still always applies in both modes."
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <RadioGroup
            android:id="@+id/securityModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioStrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strict (HTTPS only)"
                android:textColor="@color/bh_text"
                android:buttonTint="@color/bh_accent" />

            <RadioButton
                android:id="@+id/radioCtf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CTF Mode (allow http://)"
                android:textColor="@color/bh_text"
                android:buttonTint="@color/bh_accent" />
        </RadioGroup>
    </LinearLayout>

    <!-- Browser Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_section"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browser Mode"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Each mode unlocks more tools on top of the last. Resets to Basic whenever the session is cleared."
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <RadioGroup
            android:id="@+id/browserModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioModeBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Basic - standard browser"
                android:textColor="@color/bh_text"
                android:buttonTint="@color/bh_accent" />

            <RadioButton
                android:id="@+id/radioModeIntermediate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intermediate - Postman-like requests"
                android:textColor="@color/bh_text"
                android:buttonTint="@color/bh_accent" />

            <RadioButton
                android:id="@+id/radioModeAdvance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advance - JS console &amp; inspector"
                android:textColor="@color/bh_text"
                android:buttonTint="@color/bh_accent" />

            <RadioButton
                android:id="@+id/radioModeByteBandit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ByteBandit - SSH &amp; advanced pentesting tools"
                android:textColor="@color/bh_text"
                android:buttonTint="@color/bh_accent" />
        </RadioGroup>
    </LinearLayout>

    <!-- Proxy / Tor Routing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_section"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proxy / Tor Routing"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Routes all browser traffic through a SOCKS proxy - e.g. Orbot/Tor. This is real proxy routing, not per-request IP rotation: sites see the proxy's exit IP, not yours, for as long as the circuit stays the same. Install and start Orbot first if using the Tor defaults below."
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable proxy routing"
                android:textColor="@color/bh_text" />

            <Switch
                android:id="@+id/switchProxy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnPresetTor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Tor (Orbot)"
                android:textAllCaps="false"
                android:backgroundTint="@color/bh_border"
                android:textColor="@color/bh_text"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/btnPresetBurp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Burp Suite"
                android:textAllCaps="false"
                android:backgroundTint="@color/bh_border"
                android:textColor="@color/bh_text"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Burp preset assumes the default proxy listener (127.0.0.1:8080, plain http). Start Burp's proxy listener first. To see decrypted HTTPS traffic, import Burp's CA cert (Proxy &gt; Import/export CA certificate) into Android's trusted certificates."
            android:textColor="@color/bh_text_dim"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scheme"
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/inputProxyScheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="socks5"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_dim"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Host"
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/inputProxyHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="127.0.0.1"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_dim"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port"
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/inputProxyPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="9050"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_dim"
            android:inputType="number" />
    </LinearLayout>

    <!-- Session Manager -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_section"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session Manager"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off by default: no cookies, no localStorage/sessionStorage, nothing survives past the page. Turn this on if you need to stay logged into something - a CTF target, for example. A warning badge shows next to the mode indicator any time this is on, so it's never silently active. Turning it on doesn't just apply going forward: pressing Clear Session always turns this back off and wipes whatever was stored, so persistence never accidentally outlives the session you turned it on for."
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keep cookies &amp; local storage"
                android:textColor="@color/bh_text" />

            <Switch
                android:id="@+id/switchSessionPersistence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Downloads -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_section"
        android:padding="16dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Downloads"
            android:textColor="@color/bh_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Files saved to Downloads/Blackhole are deleted automatically after this many hours, independent of session clearing."
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retention (hours)"
            android:textColor="@color/bh_text_dim"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/inputDownloadRetention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="24"
            android:textColor="@color/bh_text"
            android:textColorHint="@color/bh_text_dim"
            android:inputType="number" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save and Apply"
        android:backgroundTint="@color/bh_accent"
        app:cornerRadius="24dp" />

</LinearLayout>
</ScrollView>
</LinearLayout>
