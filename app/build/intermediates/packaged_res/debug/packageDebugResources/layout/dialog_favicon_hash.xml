<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/faviconTargetUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/faviconStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fetching\u2026"
        android:textColor="@color/bh_text"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <ImageView
        android:id="@+id/faviconPreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Favicon preview" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shodan-style hash (mmh3 of base64)"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/faviconMmh3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHA-256 (raw bytes)"
        android:textColor="@color/bh_text_dim"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/faviconSha256"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
