<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bh_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/storageTargetUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/bh_text_dim"
        android:textSize="11sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="localStorage"
        android:textColor="@color/bh_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />
    <TextView
        android:id="@+id/localStorageOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sessionStorage"
        android:textColor="@color/bh_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />
    <TextView
        android:id="@+id/sessionStorageOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@color/bh_surface"
        android:padding="10dp"
        android:text=""
        android:textColor="@color/bh_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textIsSelectable="true" />

</LinearLayout>
</ScrollView>
